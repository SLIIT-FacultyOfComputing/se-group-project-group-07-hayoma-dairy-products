{
  "name": "hayoma-dairy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:headless": "cypress run --headless --browser chrome",
    "cypress:firefox": "cypress run --browser firefox",
    "cypress:edge": "cypress run --browser edge",
    "test:e2e": "cypress run --reporter mochawesome",
    "test:e2e:debug": "cypress run --headed --no-exit",
    "test:reports": "mochawesome-report-generator merge cypress/reports/mochawesome*.json --output cypress/reports/report.html",
    "test:all": "npm run test:e2e && npm run test:reports"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-slot": "^1.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.12.1",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.344.0",
    "next": "^16.2.2",
    "next-auth": "^4.24.11",
    "next-themes": "^0.2.1",
    "radix-ui": "^1.4.1",
    "react": "^18",
    "react-day-picker": "^9.7.0",
    "react-dom": "^18",
    "recharts": "^2.15.3",
    "sonner": "^1.4.3",
    "tailwind-merge": "^2.2.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@cypress/schematic": "^5.0.0",
    "@types/jwt-decode": "^2.2.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "cypress": "^15.13.0",
    "eslint": "^8",
    "eslint-config-next": "^16.2.2",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2",
    "postcss": "^8",
    "tailwindcss": "^3.3.0",
    "typescript": "^5"
  }
}
